[
  {
    "kind": "claude-code",
    "name": "Claude Code",
    "binaries": [
      "claude"
    ],
    "version": {
      "argv": [
        "--version"
      ],
      "pattern": "^(\\d+\\.\\d+\\.\\d+)",
      "timeoutMs": 5000
    },
    "drive": "shell",
    "drives": {
      "shell": {
        "argv": [
          "-c",
          "{prompt}"
        ]
      }
    },
    "mcpConfig": {
      "file": "~/.claude.json",
      "format": "claude-json",
      "key": "mcpServers"
    },
    "skillsDir": "~/.claude/skills",
    "docs": "https://code.claude.com/docs/en/headless"
  }
]
