[
  {
    "kind": "claude-code",
    "name": "Claude Code",
    "binaries": [
      "claude"
    ],
    "version": {
      "argv": [
        "--version"
      ],
      "pattern": "^(\\d+\\.\\d+\\.\\d+)",
      "timeoutMs": 60000
    },
    "drive": "claude-headless",
    "drives": {
      "claude-headless": {
        "argv": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose",
          "--strict-mcp-config",
          "--mcp-config",
          "{mcpConfig}"
        ]
      }
    },
    "mcpConfig": {
      "file": "~/.claude.json",
      "format": "claude-json",
      "key": "mcpServers"
    },
    "skillsDir": "~/.claude/skills",
    "docs": "https://code.claude.com/docs/en/headless"
  }
]
