          "method": "channel.hello",
          "params": {
            "protocols": [
              "fabric-local-channel/0.1"
            ],
            "client": {
              "name": "example-app",
              "version": "1.0.0"
            },
            "capabilities": [
              "consent.ui",
              "secret.ui"
            ]
          }
        }
      ],
      "answers": [
