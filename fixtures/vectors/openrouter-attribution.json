      "note": "a fully qualified name with its root dot is another host string"
    },
    {
      "name": "backslash-form",
      "setting": {
        "product": "observatory",
        "title": "Project Observatory",
        "categories": [
          "programming-app",
          "cli-agent"
        ]
      },
      "request": {
        "url": "https://openrouter.ai\\@evil.example/",
        "originated": true
      },
      "expect": {
        "headers": {
          "HTTP-Referer": "https://passioncode.ai/observatory/",
          "X-OpenRouter-Title": "Project Observatory",
          "X-OpenRouter-Categories": "programming-app,cli-agent"
        }
      },
      "note": "WHATWG reads the backslash as a path separator, so the host is openrouter.ai; an RFC 3986 parser reads another host, and a port follows WHATWG"
    },
