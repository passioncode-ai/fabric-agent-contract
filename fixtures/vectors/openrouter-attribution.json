{
  "description": "OpenRouter attribution (DEC-0065, openrouter-attribution.md): for each setting and request, the headers a product adds, or none with the reason. Header names in `expect` are exact; `request.headers` names compare case-insensitively. Categories are OpenRouter's App Attribution page retrieved 2026-10-12.",
  "cases": [
    {
      "name": "attributed",
      "setting": {
        "product": "observatory",
        "title": "Project Observatory",
        "categories": [
          "programming-app",
          "cli-agent"
        ]
      },
      "request": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "originated": true
      },
      "expect": {
        "headers": {
          "HTTP-Referer": "https://passioncode.ai/observatory/",
          "X-OpenRouter-Title": "Project Observatory",
          "X-OpenRouter-Categories": "programming-app,cli-agent"
        }
      }
    },
    {
      "name": "no-categories",
      "setting": {
        "product": "fabric",
        "title": "Fabric"
      },
      "request": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "originated": true
      },
      "expect": {
        "headers": {
          "HTTP-Referer": "https://passioncode.ai/fabric/",
          "X-OpenRouter-Title": "Fabric"
        }
      }
    },
    {
      "name": "off-by-default",
      "setting": null,
      "request": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "originated": true
      },
      "expect": {
        "headers": {},
        "none": "no-setting"
      }
    },
    {
      "name": "forwarded",
      "setting": {
        "product": "observatory",
        "title": "Project Observatory",
        "categories": [
          "programming-app",
          "cli-agent"
        ]
      },
      "request": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "originated": false
      },
      "expect": {
        "headers": {},
        "none": "forwarded"
      },
      "note": "a request forwarded for someone else's agent keeps its own attribution"
    },
    {
      "name": "user-set-referer",
      "setting": {
        "product": "observatory",
        "title": "Project Observatory",
        "categories": [
          "programming-app",
          "cli-agent"
        ]
      },
      "request": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "originated": true,
        "headers": {
          "http-referer": "https://example.org/"
        }
      },
      "expect": {
        "headers": {},
        "none": "user-set"
      },
      "note": "header names compare case-insensitively"
    },
    {
      "name": "user-set-legacy-title",
