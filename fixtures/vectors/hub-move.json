            "alg": "ES256"
          }
        ]
      },
      "expect": {
        "ready": false,
        "authorities": 1
      }
    },
    {
      "name": "three passkeys",
      "record": {
        "authorities": [
          {
            "credentialId": "cred-a",
            "alg": "ES256",
            "rpId": "sign.example.org",
            "origins": [
              "https://sign.example.org"
            ]
          },
          {
            "credentialId": "cred-b",
