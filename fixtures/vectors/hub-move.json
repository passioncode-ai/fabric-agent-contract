{
  "about": "Vectors for keeping an estate recoverable (DEC-0107), written by tools/vectors/hub-move.ts, never by hand. Absent values are absent members. silence: hubSilence(heartbeatAt, at), heartbeatAt the at of the heartbeat a machine holds; speaking up to 24 hours, silent past it up to 72, stale past 72; sinceSeconds floored, never below zero. recovery: recoveryReady(record), ready with two passkeys or more by distinct credentialId that the record does not revoke. move: hubMove(parent, next), added and removed by machine and kid in the order the record lists machines, revoked when next lists the removed kid as a hub-key revocation. Every case holds in every time zone.",
  "silence": [
    {
      "name": "an hour old",
      "heartbeatAt": "2026-10-23T11:00:00Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "speaking",
        "sinceSeconds": 3600
      }
    },
    {
      "name": "24 hours exactly: still speaking",
      "heartbeatAt": "2026-10-22T12:00:00Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "speaking",
        "sinceSeconds": 86400
      }
    },
    {
      "name": "a second past 24 hours: silent, the person is told",
      "heartbeatAt": "2026-10-22T11:59:59Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "silent",
        "sinceSeconds": 86401
      }
    },
    {
      "name": "half a second past 24 hours: silent, the seconds floored",
      "heartbeatAt": "2026-10-22T11:59:59.500Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "silent",
        "sinceSeconds": 86400
      }
    },
    {
      "name": "two days old",
      "heartbeatAt": "2026-10-21T12:00:00Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "silent",
        "sinceSeconds": 172800
      }
    },
    {
      "name": "72 hours exactly: still silent, calls still accepted",
      "heartbeatAt": "2026-10-20T12:00:00Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "silent",
        "sinceSeconds": 259200
      }
    },
    {
      "name": "a second past 72 hours: stale",
      "heartbeatAt": "2026-10-20T11:59:59Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "stale",
        "sinceSeconds": 259201
      }
    },
    {
      "name": "a heartbeat ahead of the clock reads as just signed",
      "heartbeatAt": "2026-10-23T12:00:30Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "speaking",
        "sinceSeconds": 0
      }
    },
    {
      "name": "an offset other than Z",
      "heartbeatAt": "2026-10-23T13:00:00+02:00",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "speaking",
        "sinceSeconds": 3600
      }
    },
    {
      "name": "no heartbeat held",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "unknown",
        "reason": "no-heartbeat"
      }
    },
    {
      "name": "a heartbeat time that does not read",
      "heartbeatAt": "2026-02-30T12:00:00Z",
      "at": "2026-10-23T12:00:00Z",
      "expect": {
        "answer": "unknown",
        "reason": "no-heartbeat"
      }
    },
    {
      "name": "a clock that does not read",
      "heartbeatAt": "2026-10-23T11:00:00Z",
      "at": "noon",
      "expect": {
        "answer": "unknown",
        "reason": "no-clock"
      }
    },
    {
      "name": "no clock and no heartbeat: the clock first",
      "heartbeatAt": null,
      "at": 7,
      "expect": {
        "answer": "unknown",
        "reason": "no-clock"
      }
    }
  ],
  "recovery": [
    {
      "name": "one passkey: a lost one loses the estate",
      "record": {
        "authorities": [
          {
            "credentialId": "cred-a",
            "alg": "ES256",
            "rpId": "sign.example.org",
            "origins": [
              "https://sign.example.org"
            ]
          }
        ]
      },
      "expect": {
        "ready": false,
        "authorities": 1
      }
    },
    {
