  "move": [
    {
      "name": "an orderly move: the old key removed, not revoked",
      "parent": {
        "machines": [
          {
            "id": "m-a",
            "hubKey": {
              "kty": "OKP",
              "crv": "Ed25519",
              "alg": "EdDSA",
              "kid": "hub-a",
              "x": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo"
            }
          },
          {
            "id": "m-b"
          }
        ]
      },
      "next": {
        "machines": [
          {
            "id": "m-a"
          },
          {
            "id": "m-b",
            "hubKey": {
              "kty": "OKP",
