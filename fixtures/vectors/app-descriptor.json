{
  "description": "An app's own descriptor (DEC-0069, service.md#an-apps-descriptor): what an app does with its descriptor on a start, and when a reader treats one as stale.",
  "action": [
    {
      "name": "none-found",
      "existing": null,
      "tool": "Example App 0.4.0",
      "expect": "write"
    },
    {
      "name": "same-version",
      "existing": {
        "installedBy": {
          "by": "person",
          "role": "operator",
          "tool": "Example App 0.4.0"
        }
      },
      "tool": "Example App 0.4.0",
      "expect": "keep"
    },
    {
      "name": "updated",
      "existing": {
        "installedBy": {
          "by": "person",
          "role": "operator",
          "tool": "Example App 0.4.0"
        }
      },
      "tool": "Example App 0.4.1",
      "expect": "write",
      "note": "an update is a reinstall"
    },
    {
      "name": "downgraded",
      "existing": {
        "installedBy": {
          "by": "person",
          "role": "operator",
          "tool": "Example App 0.4.1"
        }
      },
      "tool": "Example App 0.4.0",
      "expect": "write"
    },
    {
      "name": "string-form",
      "existing": {
        "installedBy": "Example App 0.4.0"
      },
      "tool": "Example App 0.4.0",
      "expect": "write",
      "note": "not an app's descriptor yet"
    },
    {
      "name": "case-differs",
      "existing": {
        "installedBy": {
          "by": "person",
          "role": "operator",
          "tool": "example app 0.4.0"
        }
      },
      "tool": "Example App 0.4.0",
      "expect": "write",
      "note": "tools compare as exact strings"
    }
  ],
  "stale": [
    {
      "name": "app-gone",
      "descriptor": {
        "lifecycle": {
          "manager": "person",
          "app": "/Applications/Example App.app"
        }
      },
      "appPresent": false,
      "expect": true
    },
    {
      "name": "app-present",
      "descriptor": {
        "lifecycle": {
          "manager": "person",
          "app": "/Applications/Example App.app"
        }
      },
      "appPresent": true,
      "expect": false
    },
    {
      "name": "supervised-service",
      "descriptor": {
        "lifecycle": {
          "manager": "launchd"
        }
      },
      "appPresent": false,
      "expect": false
    },
    {
      "name": "not-a-descriptor",
      "descriptor": "x",
      "appPresent": false,
      "expect": false
    }
  ]
}
