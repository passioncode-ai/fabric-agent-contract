  "listingChars": 96,
  "provider": "fabric-agent.json",
  "service": {
    "id": "inbox-digest",
    "name": "Inbox digest",
    "summary": "Writes one digest of a mailbox each morning.",
    "entry": [
      "bin/serve.mjs"
    ],
    "runtime": {
      "name": "node",
      "version": ">=22"
    }
  },
  "secrets": [
    {
      "name": "MAIL_OAUTH",
      "purpose": "Reads the mailbox the digest summarises"
    }
  ],
