    "servers": [
      "mail-gateway"
    ],
    "packages": [
      {
        "publisher": "example",
        "id": "writing-rules",
        "range": "^1"
      }
    ],
    "platforms": [
      "darwin",
      "linux",
      "windows"
    ],
    "gpu": false
  },
  "costPresets": [
    {
      "id": "quick",
      "capability": "digest.write",
      "label": "Quick",
      "maxUsd": 0.05,
      "default": true
    },
    {
      "id": "thorough",
      "capability": "digest.write",
      "label": "Thorough",
      "maxUsd": 0.4
    }
  ],
  "resultSignal": {
    "name": "digest-written",
    "says": "done when the digest is written"
  },
