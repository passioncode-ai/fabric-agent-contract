{
  "description": "runner.credentialKind carries a credential's value instead of its kind: the schema's enum refuses it and FAC-SEM-086 names the place, never the value.",
  "schema": "service-descriptor.schema.json",
  "schemaKeyword": "enum",
  "kind": "service-descriptor",
  "document": {
    "protocol": "fabric-service/0.1",
    "id": "report-writer",
    "instance": "default",
    "name": "Report Writer",
    "summary": "Writes the weekly report for the organization; hosted on an organization-managed machine.",
    "origin": "http://127.0.0.1:47231",
    "auth": {
      "tokenFile": "~/.local/share/passioncode-fabric/services/report-writer.default.token"
    },
    "lifecycle": {
      "manager": "node"
    },
    "paths": {
      "data": "~/.local/share/report-writer",
      "logs": [
        "~/.local/state/report-writer/logs/service.log"
      ]
    },
    "installedAt": "2026-10-12T09:00:00Z",
    "installedBy": {
      "by": "organization",
      "tool": "node.lifecycle install 0.1.0 (example)"
    },
    "peer": {
      "endpoint": "https://agents.example.com/report-writer/mcp",
      "custody": "organization-managed",
      "residency": [
        "DE"
      ],
      "maxDataClass": "confidential"
    },
    "runner": {
      "kind": "codex",
      "credentialKind": "Ex4mpleN0tARealKeyButShapedLikeOneAbCdEf012345"
    }
  },
  "findings": [
    {
      "code": "FAC-SEM-086",
      "instancePath": "/runner/credentialKind"
    }
  ]
}
