{
  "description": "A state path that is no store slot's, and a store slot's path the package lacks (FAC-SEM-160, DEC-0149).",
  "kind": "source-package",
  "expect": [
    "FAC-SEM-160",
    "FAC-SEM-160"
  ],
  "input": {
    "source": {
      "format": "fabric-source/1",
      "include": [
        "src/",
        "docs/",
        "README.md",
        "LICENSE"
      ],
      "exclude": [
        "src/generated/"
      ],
      "binaries": [
        "docs/icon.png"
      ],
      "publicAddresses": [
        "support@inbox-digest.example"
      ],
      "slots": [
        {
          "name": "MAIL_OAUTH",
          "kind": "secret",
          "purpose": "reads the mailbox the digest covers"
        },
        {
          "name": "DIGEST_JOURNAL",
          "kind": "store",
          "purpose": "the digests written so far",
          "path": "journal.sqlite"
        },
        {
          "name": "KNOWLEDGE_BASE",
          "kind": "endpoint",
          "purpose": "the operator's knowledge base",
          "optional": true
        }
      ]
    },
    "package": {
      "schema": "fabric-package/1",
      "secrets": [
        {
          "name": "MAIL_OAUTH",
          "purpose": "reads the mailbox the digest covers"
        }
      ],
      "state": [
        {
          "path": "journal.db",
          "purpose": "the digests written so far"
        }
      ]
    }
  }
}
