    "check": "pnpm typecheck && pnpm test && pnpm ux:lint && pnpm docs:check"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdownlint-cli2": "^0.18.1",
    "mermaid": "^11.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
