  "name": "fabric-agent-contract",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
  "description": "Fabric Agent Contract: schemas, profiles and conformance for Fabric-compatible agents",
  "homepage": "https://github.com/passioncode-ai/fabric-agent-contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passioncode-ai/fabric-agent-contract.git"
  },
