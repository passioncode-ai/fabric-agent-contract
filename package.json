  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ux:lint": "python3 docs/ux/lint.py",
    "docs:check": "tsx src/docs-check.ts && markdownlint-cli2 '**/*.md' '#node_modules'",
