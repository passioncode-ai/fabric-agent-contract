{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/binding.schema.json",
  "title": "Project capability binding revision",
  "type": "object",
  "required": ["meta", "capability", "provider", "admission", "profileKind", "executionContext", "accountPool", "grants", "dataPolicy", "coordinationPolicy", "checkerPolicy", "state"],
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/revisionMeta" },
    "project": { "$ref": "common.schema.json#/$defs/uri" },
    "scope": { "type": "object", "description": "DEC-0167 MG-2: what the record is scoped to, as roles.schema.json's assignments: the estate (the estate's manager, the ceo slot's holder) or one project. Absent: the project the record names. With a project scope, project is required and equals it (FAC-SEM-174); with an estate scope, project is absent.", "properties": { "estate": { "$ref": "common.schema.json#/$defs/uri" }, "project": { "$ref": "common.schema.json#/$defs/uri" } }, "oneOf": [{ "properties": { "estate": {} }, "required": ["estate"] }, { "properties": { "project": {} }, "required": ["project"] }], "additionalProperties": false },
    "capability": { "$ref": "common.schema.json#/$defs/capabilityUri" },
    "provider": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "admission": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "profileKind": { "enum": ["mcp", "a2a", "local-runner"] },
    "executionContext": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "accountPool": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "runnerRoute": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "grants": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/revisionRef" } },
    "dataPolicy": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "coordinationPolicy": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "checkerPolicy": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9./-]+$" },
    "nodeScope": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uri" }, "uniqueItems": true },
    "state": { "enum": ["proposed", "active", "rejected", "suspended", "superseded"] },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "runnerRoute": true }, "required": ["runnerRoute"] },
      "then": { "properties": { "profileKind": { "const": "local-runner" } } }
    },
    { "if": { "required": ["scope"], "properties": { "scope": { "type": "object", "required": ["estate"], "properties": { "estate": true } } } }, "then": { "not": { "required": ["project"], "properties": { "project": true } } }, "else": { "required": ["project"], "properties": { "project": true } } }
  ],
  "additionalProperties": false
}
