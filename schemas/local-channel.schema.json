{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/local-channel.schema.json",
  "title": "Local channel message, fabric-local-channel/0.1 (DEC-0075)",
  "description": "One JSON-RPC 2.0 message on the local channel between a Fabric surface (Fabric, Switchboard, Dashboards), or the node's own product app for secret prompts (DEC-0143), and Project Observatory's node on the same machine, or, for Fabric's hub, whichever node applies the estate's records on its machine (machine.report, DEC-0146): a Unix socket or named pipe whose peer is the same OS user, one JSON object per line. The first call is channel.hello (FAC-SEM-106).",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/notification"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "integer"
            }
          ]
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){0,4}$"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "channel.hello"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "$ref": "#/$defs/hello"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "consent.prompt"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "$ref": "#/$defs/consentPrompt"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "secret.prompt"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "$ref": "#/$defs/secretPrompt"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "integer"
            }
          ]
        },
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "data"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "data": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "unauthenticated",
                    "forbidden",
                    "schema-unsupported",
                    "hello-first",
                    "unknown-method",
                    "invalid-request",
                    "invalid-params"
                  ]
                }
              },
              "required": [
                "code"
              ]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "invalid-request"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32600
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "unknown-method"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32601
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "invalid-params"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32602
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "unauthenticated"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32001
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "forbidden"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32003
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "schema-unsupported"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32004
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "const": "hello-first"
                      }
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32005
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "required": [
        "protocols",
        "client"
      ],
      "properties": {
        "protocols": {
          "$ref": "common.schema.json#/$defs/protocols"
        },
        "client": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "consent.ui",
              "secret.ui"
            ]
          },
          "description": "What the client serves back: consent.ui lets the node send it consent.prompt (DEC-0075); secret.ui lets the node send it secret.prompt, and the node accepts it only from a peer it verified as the product's signed app (DEC-0143), else forbidden."
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "description": "Only where the operating system gives no peer credentials: read from the per-account token file (DEC-0033 ACLs), never from argv or the environment."
        }
      },
      "additionalProperties": false,
      "description": "channel.hello params."
    },
    "helloResult": {
      "type": "object",
      "required": [
        "protocols"
      ],
      "properties": {
        "protocols": {
          "$ref": "common.schema.json#/$defs/protocols"
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": [
        "status",
        "version",
        "protocols",
        "degraded"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "degraded",
            "starting"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocols": {
          "$ref": "common.schema.json#/$defs/protocols"
        },
        "degraded": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "additionalProperties": false,
      "description": "health result: an empty degraded asserts full health."
    },
    "enrollStatus": {
      "type": "object",
      "required": [
        "enrolled"
      ],
      "properties": {
        "enrolled": {
          "type": "boolean"
        },
        "org": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false,
      "description": "enroll.status result: whether this machine is enrolled, and in which organization."
    },
    "machineReport": {
      "type": "object",
      "required": [
        "report"
      ],
      "properties": {
        "report": {
          "oneOf": [
            {
              "$ref": "machine-report.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "machine.report result (DEC-0132 MR-2): the node's whole state as a machine-report/1 written at the call, its own `at`, or null while the node applies no estate records. The hub on the same machine reads it in place of a relayed report."
    },
    "consentPrompt": {
      "type": "object",
      "required": [
        "promptId",
        "purposeId",
        "noticeVersion",
        "deadline"
      ],
      "properties": {
        "promptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purposeId": {
          "$ref": "activity-common.schema.json#/$defs/purposeId"
        },
        "noticeVersion": {
          "$ref": "activity-common.schema.json#/$defs/noticeVersion"
        },
        "deadline": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "consent.prompt params, sent by the node to a client that declared consent.ui: ask the person to confirm a purpose under a notice version (DEC-0052) before the deadline; no answer by then is denied."
    },
    "consentResult": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "given",
            "denied"
          ]
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "given"
              }
            }
          },
          "then": {
            "required": [
              "at"
            ],
            "properties": {
              "at": true
            }
          }
        }
      ],
      "description": "consent.prompt result: given (with its time, the receipt evidence, DEC-0052) or denied."
    },
    "notification": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "method"
          ],
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "method": {
              "const": "consent.cancel"
            },
            "params": {
              "type": "object",
              "required": [
                "promptId"
              ],
              "properties": {
                "promptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "method",
            "params"
          ],
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "method": {
              "const": "secret.cancel"
            },
            "params": {
              "type": "object",
              "required": [
                "requestId"
              ],
              "properties": {
                "requestId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "The two notifications (no id): the node withdraws a consent prompt (consent.cancel, DEC-0075) or a secret request (secret.cancel, DEC-0143) it no longer needs."
    },
    "secretPrompt": {
      "type": "object",
      "required": [
        "requestId",
        "agent",
        "project",
        "slot",
        "reason",
        "replaces",
        "deadline"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The agent that asked, as the node's own binding for its caller names it, never words the agent sent."
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "The vault project the slot belongs to, as the node's vault names it."
        },
        "slot": {
          "type": "object",
          "required": [
            "env",
            "name"
          ],
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
              "description": "The vault environment the slot belongs to, as the node's vault names it."
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "description": "The slot's name, UPPER_SNAKE_CASE as every slot of the contract is."
            }
          },
          "additionalProperties": false
        },
        "provider": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "The agent's own words, which the client shows quoted as the agent's."
        },
        "replaces": {
          "type": "boolean",
          "description": "Whether the slot already holds a value the person would replace."
        },
        "deadline": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "secret.prompt params, sent by the node to one client that declared secret.ui and passed its signed-app check (DEC-0143): ask the person to type a value for one vault slot. The value never travels on the channel: the client writes it into the slot itself."
    },
    "secretResult": {
      "type": "object",
      "required": [
        "outcome",
        "at"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "stored",
            "declined"
          ]
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "secret.prompt result: stored (the client wrote the slot) or declined, never the value. The node answers the agent stored only after it confirmed the write itself."
    }
  }
}
