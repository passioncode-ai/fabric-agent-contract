{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/device-check-in.schema.json",
  "title": "Device check-in and its response, OpAMP-shaped (fabric-device/0.1, DEC-0031)",
  "oneOf": [
    {
      "$ref": "#/$defs/checkIn"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "checkIn": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "device",
        "sequenceNum",
        "at",
        "agent",
        "health",
        "logging",
        "collectors",
        "policy",
        "certificate"
      ],
      "properties": {
        "protocol": {
          "$ref": "device-common.schema.json#/$defs/protocol"
        },
        "kind": {
          "const": "check-in"
        },
        "device": {
          "$ref": "activity-common.schema.json#/$defs/device",
          "description": "Checked against the client certificate (FAC-SEM-045)."
        },
        "sequenceNum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "agent": {
          "type": "object",
          "required": [
            "version",
            "buildChannel"
          ],
          "properties": {
            "version": {
              "$ref": "common.schema.json#/$defs/semver"
            },
            "buildChannel": {
              "enum": [
                "official",
                "attested",
                "unofficial"
              ]
            }
          },
          "additionalProperties": false
        },
        "health": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "device-common.schema.json#/$defs/healthState"
            },
            "since": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "detail": {
              "$ref": "device-common.schema.json#/$defs/detail"
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "collectors": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "collector",
              "lastSeq",
              "bufferedFrom",
              "dropped",
              "healthy"
            ],
            "properties": {
              "collector": {
                "$ref": "activity-common.schema.json#/$defs/collector"
              },
              "source": {
                "$ref": "activity-common.schema.json#/$defs/name"
              },
              "lastSeq": {
                "type": "integer",
                "minimum": 0,
                "description": "The highest seq assigned in this stream."
              },
              "bufferedFrom": {
                "type": "integer",
                "minimum": 1,
                "description": "The lowest seq still in the buffer, or lastSeq + 1 when the buffer is empty: every seq below it was sent or dropped."
              },
              "dropped": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "activity-common.schema.json#/$defs/range"
                },
                "description": "Ranges dropped whose buffer.overflow event is not yet acknowledged."
              },
              "healthy": {
                "type": "boolean"
              },
              "error": {
                "$ref": "device-common.schema.json#/$defs/detail"
              }
            },
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "layers"
          ],
          "properties": {
            "layers": {
              "type": "array",
              "maxItems": 2,
              "contains": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "server"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "revision",
                  "status"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "mdm",
                      "server"
                    ]
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "enum": [
                      "applied",
                      "applying",
                      "failed"
                    ]
                  },
                  "error": {
                    "$ref": "device-common.schema.json#/$defs/detail"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "certificate": {
          "type": "object",
          "required": [
            "serial",
            "notAfter"
          ],
          "properties": {
            "serial": {
              "$ref": "device-common.schema.json#/$defs/serial"
            },
            "notAfter": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        },
        "fullState": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "device",
        "at",
        "nextCheckInSeconds",
        "flags"
      ],
      "properties": {
        "protocol": {
          "$ref": "device-common.schema.json#/$defs/protocol"
        },
        "kind": {
          "const": "check-in-response"
        },
        "device": {
          "$ref": "activity-common.schema.json#/$defs/device"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "nextCheckInSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "report_full_state"
            ]
          }
        },
        "policy": {
          "allOf": [
            {
              "$ref": "device-policy.schema.json"
            },
            {
              "not": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "user"
                  }
                },
                "required": [
                  "source"
                ]
              }
            }
          ]
        },
        "certificate": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "rotate",
                "re-enroll"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
