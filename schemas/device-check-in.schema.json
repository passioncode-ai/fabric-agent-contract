{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/device-check-in.schema.json",
  "title": "Device check-in and its response, OpAMP-shaped (fabric-device/0.1, DEC-0031)",
  "oneOf": [
    {
      "$ref": "#/$defs/checkIn"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "checkIn": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "device",
        "sequenceNum",
        "at",
        "agent",
        "health",
        "logging",
        "collectors",
        "policy",
        "certificate"
      ],
      "properties": {
        "protocol": {
          "$ref": "device-common.schema.json#/$defs/protocol"
        },
        "protocols": {
          "$ref": "common.schema.json#/$defs/protocols",
          "description": "DEC-0067: the protocol revisions this node reads (the records and policy it is sent). A receiver sends each document in the newest revision listed here that it also writes, and never translates one."
        },
        "kind": {
          "const": "check-in"
        },
        "device": {
          "$ref": "activity-common.schema.json#/$defs/device",
          "description": "Checked against the client certificate, or the certificate a verified request signature names (FAC-SEM-045, DEC-0056)."
        },
        "sequenceNum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "agent": {
          "type": "object",
          "required": [
            "version",
            "buildChannel"
          ],
          "properties": {
            "version": {
              "$ref": "common.schema.json#/$defs/semver"
            },
            "buildChannel": {
              "enum": [
                "official",
                "attested",
                "unofficial"
              ]
            }
          },
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "$ref": "activity-common.schema.json#/$defs/name"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
              }
            },
            "additionalProperties": false
          },
          "description": "The device's components and their versions — collector, node, key helper — so the server can tell an outdated one (DEC-0053)."
        },
        "health": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "device-common.schema.json#/$defs/healthState"
            },
            "since": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "detail": {
              "$ref": "device-common.schema.json#/$defs/detail"
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "collectors": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "collector",
              "lastSeq",
              "bufferedFrom",
              "dropped",
              "healthy"
            ],
            "properties": {
              "collector": {
                "$ref": "activity-common.schema.json#/$defs/collector"
              },
              "source": {
                "$ref": "activity-common.schema.json#/$defs/name"
              },
              "lastSeq": {
                "type": "integer",
                "minimum": 0,
                "description": "The highest seq assigned in this stream."
              },
              "bufferedFrom": {
                "type": "integer",
                "minimum": 1,
                "description": "The lowest seq still in the buffer, or lastSeq + 1 when the buffer is empty: every seq below it was sent or dropped."
              },
              "dropped": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "activity-common.schema.json#/$defs/range"
                },
                "description": "Ranges dropped whose buffer.overflow event is not yet acknowledged."
              },
              "healthy": {
                "type": "boolean"
              },
              "error": {
                "$ref": "device-common.schema.json#/$defs/detail"
              }
            },
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "layers"
          ],
          "properties": {
            "layers": {
              "type": "array",
              "maxItems": 2,
              "contains": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "server"
                  }
                },
                "required": [
                  "source"
                ]
              },
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "revision",
                  "status"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "mdm",
                      "server"
                    ]
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "enum": [
                      "applied",
                      "applying",
                      "failed"
                    ]
                  },
                  "error": {
                    "$ref": "device-common.schema.json#/$defs/detail"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "certificate": {
          "type": "object",
          "required": [
            "serial",
            "notAfter"
          ],
          "properties": {
            "serial": {
              "$ref": "device-common.schema.json#/$defs/serial"
            },
            "notAfter": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        },
        "records": {
          "type": "object",
          "properties": {
            "estateRecord": {
              "type": "object",
              "required": [
                "revision"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/sha256",
                  "description": "The applied revision's digest (DEC-0055 `digest`, `sha256:` and 64 hex), so a receiver tells two revisions with one number apart (DEC-0056). Optional."
                }
              },
              "additionalProperties": false,
              "description": "The estate-record revision the device applies, and optionally its digest (DEC-0056)."
            },
            "heartbeat": {
              "type": "object",
              "required": [
                "sequence",
                "at"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "at": {
                  "$ref": "common.schema.json#/$defs/timestamp"
                }
              },
              "additionalProperties": false,
              "description": "The latest heartbeat the device accepted (heartbeat/1, DEC-0054): its sequence and at, unchanged."
            },
            "revocationDelta": {
              "type": "object",
              "required": [
                "sequence",
                "sha256"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256Hex"
                }
              },
              "additionalProperties": false,
              "description": "The head of the revocation delta the device has applied (DEC-0054): the sequence of its last entry (0 before any) and that entry's hash (the estate's genesis at 0)."
            },
            "leases": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "leaseId",
                  "expiresAt"
                ],
                "properties": {
                  "leaseId": {
                    "$ref": "activity-common.schema.json#/$defs/opaqueId"
                  },
                  "expiresAt": {
                    "$ref": "common.schema.json#/$defs/timestamp"
                  },
                  "spent": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$",
                    "description": "An upper bound on what the meter spent in the lease's window instance: settled receipts plus open reservations, a decimal USD string (DEC-0062). Absent, the lease is unreported, and the hub counts its whole amount as spent once it expires."
                  }
                },
                "additionalProperties": false
              },
              "description": "The window leases the device's meter holds (window-lease/1, DEC-0062), each by leaseId and expiresAt, with what it spent."
            },
            "nodeSummary": {
              "$ref": "node-summary.schema.json",
              "description": "DEC-0101: the node's summary of its harness for this enrollment's organization, when it changed or at least once a day."
            },
            "repairResults": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "repair-result.schema.json"
              },
              "description": "DEC-0101, DEC-0102: the node's one result per repair id, the same stored result again for a redelivered request."
            }
          },
          "additionalProperties": false,
          "description": "What the device holds of the records the relay protocol carries (DEC-0053): the estate revision it applies, the latest heartbeat and the revocation delta's head (DEC-0054), and the leases its meter holds (window-lease/1, DEC-0062)."
        },
        "fullState": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "device",
        "at",
        "nextCheckInSeconds",
        "flags"
      ],
      "properties": {
        "protocols": {
          "$ref": "common.schema.json#/$defs/protocols",
          "description": "DEC-0094: the protocol revisions this server accepts from the device, so a node learns them at check-in (DEC-0067's list)."
        },
        "protocol": {
          "$ref": "device-common.schema.json#/$defs/protocol"
        },
        "kind": {
          "const": "check-in-response"
        },
        "device": {
          "$ref": "activity-common.schema.json#/$defs/device"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "nextCheckInSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "report_full_state"
            ]
          }
        },
        "collectionStart": {
          "$ref": "common.schema.json#/$defs/timestamp",
          "description": "When this device's collection for the organization started: the notice's acknowledgement, or under device management the earlier of it and the deadline (DEC-0053). Absent: not started. Events that occurred before it are never uploaded."
        },
        "acknowledgedNoticeVersion": {
          "$ref": "activity-common.schema.json#/$defs/noticeVersion",
          "description": "The latest noticeVersion this device's person acknowledged to the organization (DEC-0102), on every response once there is one. Absent: none yet. A collector held by a purpose rejection resumes when a present value differs from what it held at the rejection, absence included; a value that becomes absent never resumes."
        },
        "keySet": {
          "$ref": "device-key-set.schema.json"
        },
        "policy": {
          "allOf": [
            {
              "$ref": "device-policy.schema.json"
            },
            {
              "not": {
                "type": "object",
                "properties": {
                  "source": {
                    "const": "user"
                  }
                },
                "required": [
                  "source"
                ]
              }
            }
          ]
        },
        "records": {
          "type": "object",
          "properties": {
            "heartbeat": {
              "$ref": "heartbeat.schema.json",
              "description": "A newer signed heartbeat (heartbeat/1, DEC-0054), carried unchanged."
            },
            "revocationDelta": {
              "$ref": "revocation-delta.schema.json",
              "description": "The revocation delta since the head the device reported: a page (revocation-delta/1, DEC-0054), carried unchanged."
            },
            "leases": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "window-lease.schema.json",
                "description": "A window lease (window-lease/1, DEC-0062), carried unchanged; the device's meter verifies it before it spends against it."
              }
            },
            "repairs": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "repair-request.schema.json"
              },
              "description": "DEC-0101: repairs the organization asks of this node, each signed by a key of the current policy key set, carried unchanged."
            }
          },
          "additionalProperties": false,
          "description": "Records the server hands the device at check-in (DEC-0053): a heartbeat and a page of the revocation delta (DEC-0054) and leases (window-lease/1, DEC-0062), each carried unchanged."
        },
        "certificate": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "rotate",
                "re-enroll"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
