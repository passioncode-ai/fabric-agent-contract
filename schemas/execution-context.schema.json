{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/execution-context.schema.json",
  "title": "Execution context or project account pool",
  "oneOf": [
    { "$ref": "#/$defs/context" },
    { "$ref": "#/$defs/pool" }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "required": ["kind", "meta", "provider", "workingDirectory", "environment", "accountPool", "limits", "cleanup"],
      "properties": {
        "kind": { "const": "execution-context" },
        "meta": { "$ref": "common.schema.json#/$defs/revisionMeta" },
        "project": { "$ref": "common.schema.json#/$defs/uri" },
        "scope": { "type": "object", "description": "DEC-0167 MG-2: what the record is scoped to, as roles.schema.json's assignments: the estate (the estate's manager, the ceo slot's holder) or one project. Absent: the project the record names. With a project scope, project is required and equals it (FAC-SEM-174); with an estate scope, project is absent.", "properties": { "estate": { "$ref": "common.schema.json#/$defs/uri" }, "project": { "$ref": "common.schema.json#/$defs/uri" } }, "oneOf": [{ "properties": { "estate": {} }, "required": ["estate"] }, { "properties": { "project": {} }, "required": ["project"] }], "additionalProperties": false },
        "agent": { "$ref": "common.schema.json#/$defs/uri" },
        "provider": { "$ref": "common.schema.json#/$defs/revisionRef" },
        "workingDirectory": { "type": "object", "required": ["repository", "mode"], "properties": { "repository": { "$ref": "common.schema.json#/$defs/uri" }, "mode": { "enum": ["project-root", "worktree", "temporary"] } }, "additionalProperties": false },
        "environment": {
          "type": "object",
          "required": ["ambient", "entries"],
          "properties": {
            "ambient": { "const": "deny" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
                  "value": { "type": "string" },
                  "secretRef": { "$ref": "common.schema.json#/$defs/uri" }
                },
                "oneOf": [{ "properties": { "value": {} }, "required": ["value"] }, { "properties": { "secretRef": {} }, "required": ["secretRef"] }],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "accountPool": { "$ref": "common.schema.json#/$defs/revisionRef" },
        "selectedAccount": { "$ref": "common.schema.json#/$defs/uri" },
        "networkScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "filesystemScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "toolScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limits": { "type": "object", "required": ["wallSeconds", "concurrency"], "properties": { "wallSeconds": { "type": "integer", "minimum": 1 }, "costMicrounits": { "type": "integer", "minimum": 0 }, "concurrency": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
        "cleanup": { "type": "object", "required": ["revokeSecrets", "stopChildren", "preserveResidueUntilReconciled"], "properties": { "revokeSecrets": { "const": true }, "stopChildren": { "const": true }, "preserveResidueUntilReconciled": { "const": true } }, "additionalProperties": false }
      },
      "allOf": [
        { "if": { "required": ["scope"], "properties": { "scope": { "type": "object", "required": ["estate"], "properties": { "estate": true } } } }, "then": { "not": { "required": ["project"], "properties": { "project": true } } }, "else": { "required": ["project"], "properties": { "project": true } } }
      ],
      "additionalProperties": false
    },
    "pool": {
      "type": "object",
      "required": ["kind", "meta", "project", "providerFamily", "accounts", "fallbackReasons"],
      "properties": {
        "kind": { "const": "account-pool" },
        "meta": { "$ref": "common.schema.json#/$defs/revisionMeta" },
        "project": { "$ref": "common.schema.json#/$defs/uri" },
        "providerFamily": { "type": "string", "minLength": 1 },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["accountRef", "secretRef", "priority", "enabled"],
            "properties": {
              "accountRef": { "$ref": "common.schema.json#/$defs/uri" },
              "secretRef": { "$ref": "common.schema.json#/$defs/uri" },
              "priority": { "type": "integer", "minimum": 1 },
              "enabled": { "type": "boolean" },
              "cooldownSeconds": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "fallbackReasons": { "type": "array", "uniqueItems": true, "items": { "enum": ["rate-limit", "provider-unavailable", "expired-session", "transient-health"] } }
      },
      "additionalProperties": false
    }
  }
}
