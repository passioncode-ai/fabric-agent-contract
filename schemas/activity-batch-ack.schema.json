{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/activity-batch-ack.schema.json",
  "title": "Activity batch acknowledgement (fabric-activity/0.1, DEC-0030)",
  "description": "accepted + duplicates + rejected equals the events of the batch; acks[].seq is the highest seq up to which every event of the stream is held, rejected or accounted for by an overflow (FAC-SEM-039).",
  "type": "object",
  "required": [
    "protocol",
    "device",
    "received",
    "accepted",
    "duplicates",
    "rejected",
    "acks"
  ],
  "properties": {
    "protocol": {
      "$ref": "activity-common.schema.json#/$defs/protocol"
    },
    "device": {
      "$ref": "activity-common.schema.json#/$defs/device"
    },
    "batchId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "received": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "reason"
        ],
        "properties": {
          "eventId": {
            "$ref": "activity-common.schema.json#/$defs/eventId"
          },
          "reason": {
            "enum": [
              "schema",
              "content-field",
              "person-field",
              "stream",
              "attribution"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "acks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "collector",
          "seq"
        ],
        "properties": {
          "collector": {
            "$ref": "activity-common.schema.json#/$defs/collector"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "held": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "activity-common.schema.json#/$defs/range"
            },
            "description": "Ranges above seq that the receiver holds or has accounted for; the device may drop them."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
