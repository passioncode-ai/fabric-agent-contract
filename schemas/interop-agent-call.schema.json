{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/interop-agent-call.schema.json",
  "title": "fabric-interop/0.1 hub agent.call arguments",
  "type": "object",
  "required": [
    "agentId",
    "capability",
    "input"
  ],
  "properties": {
    "agentId": {
      "$ref": "common.schema.json#/$defs/agentId"
    },
    "capability": {
      "$ref": "common.schema.json#/$defs/capabilityName"
    },
    "input": {
      "type": "object"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision": {
      "$ref": "decision.schema.json",
      "description": "The operator's decision the hub forwards unchanged for a T1 origin and drops for a T2 origin (DEC-0121 AP-2)."
    }
  },
  "additionalProperties": false
}
