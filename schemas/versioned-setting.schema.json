{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/versioned-setting.schema.json",
  "title": "Immutable setting revision",
  "type": "object",
  "required": ["meta", "kind", "parents", "reason", "payload"],
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/revisionMeta" },
    "kind": { "enum": ["prompt", "pipeline", "policy", "binding", "execution-context", "account-pool", "runner-route", "schedule", "grant", "checker"] },
    "parents": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/revisionRef" } },
    "reason": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "rollbackBasis": { "$ref": "common.schema.json#/$defs/revisionRef" },
    "approvals": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uri" } }
  },
  "additionalProperties": false
}
