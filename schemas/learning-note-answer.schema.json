{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/learning-note-answer.schema.json",
  "title": "Answer to a learning note (DEC-0072)",
  "description": "Fabric's answer: accepted or duplicate with the proposal it filed, or rejected with a reason. The sender keeps only the answer and reads the proposal's status back.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "result",
        "proposalId"
      ],
      "properties": {
        "result": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "proposalId": {
          "$ref": "common.schema.json#/$defs/uri"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "result",
        "reason"
      ],
      "properties": {
        "result": {
          "const": "rejected"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  ]
}
