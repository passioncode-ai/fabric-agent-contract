{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/activity-batch.schema.json",
  "title": "Activity batch: what a device sends (fabric-activity/0.1, DEC-0030)",
  "type": "object",
  "required": [
    "protocol",
    "device",
    "sent",
    "events"
  ],
  "properties": {
    "protocol": {
      "$ref": "activity-common.schema.json#/$defs/protocol"
    },
    "device": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        }
      },
      "additionalProperties": false
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sent": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "allOf": [
          {
            "$ref": "activity-event.schema.json"
          },
          {
            "not": {
              "type": "object",
              "properties": {
                "received": true
              },
              "required": [
                "received"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
