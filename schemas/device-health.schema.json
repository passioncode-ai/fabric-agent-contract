{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/device-health.schema.json",
  "title": "Device health as the organization server judges it (fabric-device/0.1, DEC-0031)",
  "type": "object",
  "required": [
    "protocol",
    "kind",
    "device",
    "state",
    "since",
    "observedAt",
    "reasons"
  ],
  "properties": {
    "protocol": {
      "$ref": "device-common.schema.json#/$defs/protocol"
    },
    "kind": {
      "const": "health"
    },
    "device": {
      "$ref": "activity-common.schema.json#/$defs/device"
    },
    "state": {
      "$ref": "device-common.schema.json#/$defs/healthState"
    },
    "since": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lastCheckIn": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "reasons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "activity-common.schema.json#/$defs/name"
          },
          "detail": {
            "$ref": "device-common.schema.json#/$defs/detail"
          },
          "gapSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "For re_enrolled: seconds between the device's last check-in under its earlier epoch and the re-enrollment."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "For re_enrolled: re-enrollments of this device in the server's window, this one included."
          }
        },
        "additionalProperties": false,
        "description": "Open vocabulary code with a bounded detail. Known codes include re_enrolled (DEC-0052): a re-enrollment is no tamper evidence, but its gap and count are posture a reader sees."
      }
    }
  },
  "additionalProperties": false
}
