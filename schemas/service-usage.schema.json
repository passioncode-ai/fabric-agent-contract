{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/service-usage.schema.json",
  "title": "Service usage report (fabric-service/0.1, DEC-0021, DEC-0027, DEC-0183)",
  "description": "What a service's model and paid-tool calls cost (money, and a subscription's estimate apart by route, DEC-0110), self-reported from its own usage receipts, in UTC days. An unknown cost is null, never 0.",
  "type": "object",
  "required": [
    "protocol",
    "service",
    "generatedAt",
    "currency",
    "days"
  ],
  "properties": {
    "protocol": {
      "const": "fabric-service/0.1"
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "instance"
      ],
      "properties": {
        "id": {
          "$ref": "service-common.schema.json#/$defs/serviceId"
        },
        "instance": {
          "$ref": "service-common.schema.json#/$defs/instance"
        }
      },
      "additionalProperties": false
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "currency": {
      "const": "USD"
    },
    "days": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "budgets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/limit"
      },
      "description": "Every spending limit the service applies, enforced or not (DEC-0027). Ids are unique (FAC-SEM-031)."
    },
    "limitChanges": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/limitChange"
      },
      "description": "DEC-0183 SL-4: the latest changes of the limits in budgets[], newest first, at most 64, so a host shows who changed what. Ids are unique (FAC-SEM-031)."
    },
    "months": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/month"
      },
      "description": "DEC-0183 SL-6: money per UTC month for up to the last 12 months, oldest first, the current month last and partial, so a host can chart beyond the 31 days of days[] (FAC-SEM-031)."
    },
    "byGrant": {
      "type": "array",
      "description": "DEC-0037: cost in the report's window attributed to each grant that authorized it (grant check receipts), a subscription's estimate included (DEC-0110).",
      "items": {
        "type": "object",
        "required": [
          "grantRef",
          "calls",
          "costUsd"
        ],
        "properties": {
          "grantRef": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "costUsd": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "receipts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The grant-check receipts this spend settles."
          }
        },
        "additionalProperties": false
      }
    },
    "byProject": {
      "type": "array",
      "maxItems": 256,
      "description": "DEC-0065 (CON-OE-13): cost in the report's window by the project the service ran it for, a subscription's estimate included (DEC-0110), the service's own run attribution. It names no caller, session or person (DL-22). A call the service ran for no project is in no row. Sums and unknown costs: FAC-SEM-025.",
      "items": {
        "type": "object",
        "required": [
          "projectId",
          "calls",
          "costUsd"
        ],
        "properties": {
          "projectId": {
            "$ref": "common.schema.json#/$defs/uri"
          },
          "calls": {
            "$ref": "#/$defs/count"
          },
          "unpricedCalls": {
            "$ref": "#/$defs/count"
          },
          "costUsd": {
            "$ref": "#/$defs/money"
          },
          "taskRuns": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": [
                "taskRunId",
                "calls",
                "costUsd"
              ],
              "properties": {
                "taskRunId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "description": "The service's own id of the task run that spent: never a caller's identity (DL-22)."
                },
                "calls": {
                  "$ref": "#/$defs/count"
                },
                "unpricedCalls": {
                  "$ref": "#/$defs/count"
                },
                "costUsd": {
                  "$ref": "#/$defs/money"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "money": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "totals": {
      "type": "object",
      "required": [
        "calls",
        "unpricedCalls",
        "inputTokens",
        "outputTokens",
        "costUsd"
      ],
      "properties": {
        "calls": {
          "$ref": "#/$defs/count"
        },
        "unpricedCalls": {
          "$ref": "#/$defs/count"
        },
        "unmeasuredCalls": {
          "$ref": "#/$defs/count",
          "description": "Every call whose token count the service did not measure in full, whatever it wrote to its caller (a null to a fabric-interop/0.2 reader, the measured lower bound to a 0.1 reader, a number beside partial: true, a call outside a job): while above 0 the token totals are a lower bound. Absent is 0 (DEC-0091)."
        },
        "inputTokens": {
          "$ref": "#/$defs/count"
        },
        "outputTokens": {
          "$ref": "#/$defs/count"
        },
        "cacheReadTokens": {
          "$ref": "#/$defs/count"
        },
        "cacheWriteTokens": {
          "$ref": "#/$defs/count"
        },
        "costUsd": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "model": {
      "allOf": [
        {
          "$ref": "#/$defs/totals"
        }
      ],
      "type": "object",
      "required": [
        "provider",
        "model",
        "costBasis"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "costBasis": {
          "enum": [
            "provider",
            "price-list",
            "mixed",
            "unknown"
          ]
        },
        "route": {
          "enum": [
            "subscription",
            "key",
            "platform-metered"
          ],
          "description": "DEC-0046, DEC-0061: the route the row's calls took — the operator's own login in its vendor's runner, an issued key, or the hosting platform's own metered models under the deployment's account (a listing in the cloud, the descriptor's runner.credentialKind platform-metered). Absent: not stated (a report written before DEC-0046)."
        }
      },
      "unevaluatedProperties": false
    },
    "day": {
      "allOf": [
        {
          "$ref": "#/$defs/totals"
        }
      ],
      "type": "object",
      "required": [
        "date",
        "byModel"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "byModel": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "period",
        "limitUsd",
        "spentUsd"
      ],
      "properties": {
        "period": {
          "enum": [
            "day",
            "month"
          ]
        },
        "limitUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spentUsd": {
          "$ref": "#/$defs/money"
        }
      },
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "description": "One spending limit and what was spent against it in its window (DEC-0027); editable and its bounds, DEC-0183.",
      "required": [
        "id",
        "scope",
        "kind",
        "limitUsd",
        "spentUsd",
        "enforced"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
        },
        "scope": {
          "enum": [
            "machine",
            "project",
            "pool",
            "job"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "Open vocabulary. Known values: per_job, approval, daily, weekly, monthly, velocity, pool, emergency (weekly: DEC-0183). A reader shows an unknown kind generically and never rejects it."
        },
        "period": {
          "enum": [
            "day",
            "week",
            "month"
          ],
          "description": "The current calendar UTC day, ISO week (from Monday 00:00 UTC; DEC-0183 SL-1) or month."
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "since": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "limitUsd": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "spentUsd": {
          "$ref": "#/$defs/money"
        },
        "enforced": {
          "type": "boolean"
        },
        "tripped": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean",
          "description": "DEC-0183 SL-3: true when the service takes spend.limits.set for this limit; absent or false, a host offers no edit."
        },
        "minUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "DEC-0183 SL-3: the lowest limitUsd the service takes for this limit (only with editable: true)."
        },
        "maxUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "DEC-0183 SL-3: the highest limitUsd the service takes for this limit (only with editable: true)."
        }
      },
      "additionalProperties": false
    },
    "limitState": {
      "type": "object",
      "description": "A limit's settable state before or after a change (DEC-0183).",
      "required": [
        "limitUsd",
        "enforced"
      ],
      "properties": {
        "limitUsd": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "enforced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "limitChange": {
      "type": "object",
      "description": "One change of a limit (DEC-0183 SL-4): when, by which kind of actor, through which door, before and after, and why. It names no person: byRef is opaque (DL-22).",
      "required": [
        "id",
        "at",
        "by",
        "via",
        "limitId",
        "before",
        "after",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "by": {
          "enum": [
            "operator",
            "agent",
            "service"
          ],
          "description": "Whose decision the change is (DEC-0183 SL-4): operator: the operator's, at the dashboard or relayed by an agent with _meta.decision (DEC-0121 AP-2); agent: an agent's own tightening, with no decision (SL-2); service: the service itself (a default applied, its configuration read at start)."
        },
        "byRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "An opaque reference of the actor (a grant, an agent id, an audit record), never a name, an email or a session id."
        },
        "via": {
          "enum": [
            "dashboard",
            "agent",
            "config"
          ],
          "description": "The door the change came through: the service's dashboard, its agent surface (spend.limits.set), or its own configuration."
        },
        "limitId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
        },
        "before": {
          "oneOf": [
            {
              "$ref": "#/$defs/limitState"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the change created the limit."
        },
        "after": {
          "$ref": "#/$defs/limitState"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "month": {
      "type": "object",
      "description": "Money in one UTC month (DEC-0183 SL-6): costUsd sums the rows not on a subscription (DEC-0110), null when none is priced.",
      "required": [
        "month",
        "calls",
        "unpricedCalls",
        "costUsd"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "calls": {
          "$ref": "#/$defs/count"
        },
        "unpricedCalls": {
          "$ref": "#/$defs/count"
        },
        "costUsd": {
          "$ref": "#/$defs/money"
        }
      },
      "additionalProperties": false
    }
  }
}
