{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/grant-check.schema.json",
  "title": "Grant check answer (DEC-0037)",
  "oneOf": [
    {
      "$ref": "#/$defs/allowed"
    },
    {
      "$ref": "#/$defs/denied"
    }
  ],
  "$defs": {
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "description": "L0 estate total, L1 project policy, L2 task budget, L3 call."
    },
    "allowed": {
      "type": "object",
      "required": [
        "decision",
        "receipt",
        "grantRef",
        "checkedAt"
      ],
      "properties": {
        "decision": {
          "const": "allowed"
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "grantRef": {
          "type": "string",
          "minLength": 1
        },
        "remainingUsd": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "denied": {
      "type": "object",
      "required": [
        "decision",
        "level",
        "reason",
        "checkedAt"
      ],
      "properties": {
        "decision": {
          "const": "denied"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approvalRequest": {
          "$ref": "common.schema.json#/$defs/uri",
          "description": "The durable request filed for this spend, when the limit allows one."
        },
        "checkedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
