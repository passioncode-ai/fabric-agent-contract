{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/activity-summary-2.schema.json",
  "title": "Activity summary activity-summary/2 (DEC-0030, DEC-0171)",
  "description": "activity-summary/1's cells, plus (DEC-0171) turn cells per agent x skill x project x UTC day and inventory cells per provider x plan x billing x UTC day, built by a receiver from many devices' events. There is no person dimension and no device producer; a cell of any kind is published only when its population reaches minPopulation, and the rest of a day is folded into one other cell of its kind or suppressed (FAC-SEM-040).",
  "type": "object",
  "required": [
    "format",
    "generatedAt",
    "from",
    "to",
    "producer",
    "idleThresholdSeconds",
    "minPopulation",
    "cells",
    "turnCells",
    "inventoryCells"
  ],
  "properties": {
    "format": {
      "const": "activity-summary/2"
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "from": {
      "$ref": "activity-common.schema.json#/$defs/day"
    },
    "to": {
      "$ref": "activity-common.schema.json#/$defs/day"
    },
    "producer": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        }
      },
      "additionalProperties": false,
      "description": "The receiver that built the summary. A device never produces one."
    },
    "idleThresholdSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "minPopulation": {
      "type": "integer",
      "minimum": 3,
      "description": "The smallest population a published cell covers; at least 3 (DEC-0030)."
    },
    "suppressedCells": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Cells of any kind (session, turn or inventory) below minPopulation that could not be folded into a publishable other cell of their kind and were not published."
    },
    "cells": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/cell"
          },
          {
            "$ref": "#/$defs/otherCell"
          }
        ]
      }
    },
    "turnCells": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/turnCell"
          },
          {
            "$ref": "#/$defs/otherTurnCell"
          }
        ]
      },
      "description": "DEC-0171 RT-4: the agent turns of coding-agent runtimes; a turn cell's population counts people, each turn's subject the person bound to its stream's epoch, a turn from a device bound to no person its device."
    },
    "inventoryCells": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/inventoryCell"
          },
          {
            "$ref": "#/$defs/otherInventoryCell"
          }
        ]
      },
      "description": "DEC-0171 SI-5: the organization accounts machines held; an inventory cell's population counts people, each machine's bound person, a machine bound to no person counting as one."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "counts": {
      "type": "object",
      "required": [
        "population",
        "sessions",
        "intervals",
        "usageLines"
      ],
      "properties": {
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct subjects the cell covers: each event counts its user.id when it carries one, else its session.id."
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intervals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usageLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unpricedLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "tokens",
        "cost"
      ],
      "properties": {
        "tokens": {
          "$ref": "activity-common.schema.json#/$defs/tokens"
        },
        "cost": {
          "type": "object",
          "required": [
            "usd"
          ],
          "properties": {
            "usd": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "basis": {
              "enum": [
                "provider",
                "price-list",
                "client-estimate",
                "mixed"
              ]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "usd": {
                    "type": "number"
                  }
                },
                "required": [
                  "usd"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "basis": true
                },
                "required": [
                  "basis"
                ]
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "usd": {
                    "type": "null"
                  }
                },
                "required": [
                  "usd"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "basis": false
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "otherCell": {
      "type": "object",
      "required": [
        "other",
        "day",
        "counts",
        "durations",
        "method",
        "usage"
      ],
      "properties": {
        "other": {
          "const": true
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "durations": {
          "$ref": "activity-common.schema.json#/$defs/durations"
        },
        "method": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "additionalProperties": false,
      "description": "The day's cells below minPopulation, folded together with no agent, skill, project or outcome."
    },
    "cell": {
      "type": "object",
      "required": [
        "agent",
        "project",
        "day",
        "outcome",
        "counts",
        "durations",
        "method",
        "usage"
      ],
      "properties": {
        "agent": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "skill": {
          "$ref": "activity-common.schema.json#/$defs/skill"
        },
        "project": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "outcome": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "durations": {
          "$ref": "activity-common.schema.json#/$defs/durations"
        },
        "method": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "additionalProperties": false
    },
    "turnBuckets": {
      "type": "object",
      "required": [
        "under1s",
        "under5s",
        "under15s",
        "under60s",
        "under300s",
        "from300s"
      ],
      "properties": {
        "under1s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "under5s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "under15s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "under60s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "under300s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "from300s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "The turns counted per fixed bucket of turnMs: under 1 s, 5 s, 15 s, 60 s and 300 s, and 300 s or more; mergeable across cells and days, so a reader finds the bucket a median or a 95th percentile falls in. They add up to turns (FAC-SEM-040)."
    },
    "turnCell": {
      "type": "object",
      "required": [
        "agent",
        "project",
        "day",
        "population",
        "turns",
        "turnBuckets",
        "modelMs",
        "toolMs"
      ],
      "properties": {
        "agent": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "skill": {
          "$ref": "activity-common.schema.json#/$defs/skill"
        },
        "project": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct people the cell covers (DEC-0171 RT-4): the person bound to each turn's stream's epoch, or its device when the device is bound to no person; one person's sessions are one subject, and so are one unbound device's."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turnBuckets": {
          "$ref": "#/$defs/turnBuckets"
        },
        "modelMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "otherTurnCell": {
      "type": "object",
      "required": [
        "other",
        "day",
        "population",
        "turns",
        "turnBuckets",
        "modelMs",
        "toolMs"
      ],
      "properties": {
        "other": {
          "const": true
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct people the cell covers (DEC-0171 RT-4): the person bound to each turn's stream's epoch, or its device when the device is bound to no person; one person's sessions are one subject, and so are one unbound device's."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turnBuckets": {
          "$ref": "#/$defs/turnBuckets"
        },
        "modelMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "The day's turn cells below minPopulation, folded together with no agent, skill or project."
    },
    "inventoryCell": {
      "type": "object",
      "required": [
        "provider",
        "billing",
        "day",
        "population",
        "machines",
        "accounts"
      ],
      "properties": {
        "provider": {
          "$ref": "activity-common.schema.json#/$defs/name"
        },
        "plan": {
          "$ref": "activity-common.schema.json#/$defs/plan"
        },
        "billing": {
          "enum": [
            "subscription",
            "api"
          ]
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct people the cell covers (DEC-0171 SI-5): each machine's bound person, a machine bound to no person counting as one."
        },
        "machines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accounts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "billing": {
                "const": "api"
              }
            },
            "required": [
              "billing"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "plan": false
            }
          }
        }
      ]
    },
    "otherInventoryCell": {
      "type": "object",
      "required": [
        "other",
        "day",
        "population",
        "machines",
        "accounts"
      ],
      "properties": {
        "other": {
          "const": true
        },
        "day": {
          "$ref": "activity-common.schema.json#/$defs/day"
        },
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct people the cell covers (DEC-0171 SI-5): each machine's bound person, a machine bound to no person counting as one."
        },
        "machines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accounts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "The day's inventory cells below minPopulation, folded together with no provider, plan or billing."
    }
  }
}
