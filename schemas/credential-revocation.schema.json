{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/credential-revocation.schema.json",
  "title": "An organization revokes a credential it issued into its context on one machine, credential-revocation/1 (DEC-0111)",
  "description": "Carried in a check-in response's records.credentialRevocations, signed like a policy layer by a key of the organization's current policy key set (policySigningInput). The node deletes the value and its mark when credentialRevocationStands accepts it; the issuer revokes the credential at its provider as well. docs/specification/credentials.md#revocation.",
  "type": "object",
  "required": [
    "type",
    "org",
    "device",
    "context",
    "agentRef",
    "slot",
    "revokedAt",
    "signature"
  ],
  "properties": {
    "type": {
      "const": "credential-revocation/1"
    },
    "org": {
      "$ref": "device-common.schema.json#/$defs/org"
    },
    "device": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/orgContextId"
    },
    "agentRef": {
      "$ref": "fabric-package.schema.json#/$defs/agentRef"
    },
    "slot": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "description": "the credential's slot name, never its value"
    },
    "revokedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "reason": {
      "enum": [
        "administrator",
        "member-left",
        "agent-removed",
        "rotated",
        "leaked"
      ]
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "keyId",
        "value"
      ],
      "properties": {
        "alg": {
          "enum": [
            "ed25519",
            "es256"
          ]
        },
        "keyId": {
          "$ref": "activity-common.schema.json#/$defs/opaqueId"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "description": "64 bytes, base64: an Ed25519 signature, or an ES256 signature as R ‖ S."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
