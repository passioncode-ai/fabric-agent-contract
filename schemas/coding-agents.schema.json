{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.passioncode.ai/agent-contract/0.1.0/schemas/coding-agents.schema.json",
  "title": "The coding-agent catalogue (DEC-0093): one list of coding agents for every product",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "agents"
  ],
  "properties": {
    "schema": {
      "const": "coding-agents/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Raised by one on every change of the file."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "retired": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "description": "Ids no longer listed; never reused."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "description": "An environment variable's name, never its value."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 512
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "install": {
      "type": "object",
      "required": [
        "via"
      ],
      "properties": {
        "via": {
          "enum": [
            "brew",
            "brew-cask",
            "npm",
            "uv",
            "pipx",
            "script"
          ]
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214,
          "description": "The package name for brew, brew-cask, npm, uv or pipx."
        },
        "script": {
          "$ref": "#/$defs/url",
          "description": "For via script: the maker's install script, fetched and run by the person's launcher."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "macos",
              "linux",
              "windows"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "maker",
        "url",
        "launch",
        "mcp",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "The stable id every product keys its machine state by; equal to the runner kind where DEC-0046 catalogues one (runners.md, C2)."
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Other names a product used for this agent; a product that keyed its state by one reads it as this id. Never another entry's id."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "maker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "install": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/install"
          }
        },
        "launch": {
          "type": "object",
          "required": [
            "argv"
          ],
          "properties": {
            "argv": {
              "$ref": "#/$defs/argv"
            }
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "required": [
            "skip"
          ],
          "properties": {
            "skip": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "argv": {
                  "$ref": "#/$defs/argv"
                },
                "env": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 8,
                  "propertyNames": {
                    "$ref": "#/$defs/env"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "oneOf": [
            {
              "properties": {
                "source": {
                  "$ref": "#/$defs/url",
                  "description": "The maker's own documentation that names the argument or variable."
                }
              },
              "required": [
                "source"
              ]
            },
            {
              "properties": {
                "measured": {
                  "type": "object",
                  "required": [
                    "argv",
                    "version",
                    "date"
                  ],
                  "properties": {
                    "argv": {
                      "$ref": "#/$defs/argv",
                      "description": "The command whose output names it, such as the agent's --help."
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "date": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Where no documentation was read: the installed agent's own help, at a version, on a date."
                }
              },
              "required": [
                "measured"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        "mcp": {
          "type": "boolean",
          "description": "Whether the agent loads MCP servers."
        },
        "openrouter": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "keyEnv": {
              "$ref": "#/$defs/env"
            },
            "baseUrlEnv": {
              "$ref": "#/$defs/env"
            },
            "modelEnv": {
              "$ref": "#/$defs/env"
            },
            "homeEnv": {
              "$ref": "#/$defs/env"
            },
            "modelArgv": {
              "$ref": "#/$defs/argv",
              "description": "Arguments that name the model, with {model} where the model id goes."
            }
          },
          "additionalProperties": false
        },
        "proxy": {
          "type": "object",
          "required": [
            "baseUrlEnv"
          ],
          "properties": {
            "baseUrlEnv": {
              "$ref": "#/$defs/env"
            },
            "keyCommand": {
              "$ref": "#/$defs/argv",
              "description": "A command that prints the proxy's key; its output is never stored."
            }
          },
          "additionalProperties": false
        },
        "runner": {
          "$ref": "runners.schema.json#/$defs/runner",
          "description": "The detection and drive entry of DEC-0046, where measured."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/url"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
