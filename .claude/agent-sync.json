{
  "backend": "notion",
  "leaseBackend": "git",
  "leaseRemote": "origin",
  "integrationBranch": "main",
  "leaseTtlSeconds": 2700,
  "renewIntervalSeconds": 300,
  "gated": true,
  "idRegisters": {
    "DEC": {
      "file": "docs/DECISIONS.md",
      "nextFreeIdPattern": "\\*\\*Next free ID:\\*\\* `DEC-(\\d{4})`"
    },
    "SEM": {
      "file": "docs/specification/conformance.md",
      "nextFreeIdPattern": "\\*\\*Next free rule code:\\*\\* `FAC-SEM-(\\d{3})`"
    }
  },
  "guardedFiles": [
    "docs/DECISIONS.md",
    "docs/OPEN_QUESTIONS.md",
    "docs/evidence/specs/*-modules.md",
    "docs/backlog-sources.json",
    "docs/backlog.md",
    "docs/specification/conformance.md"
  ],
  "claimTags": {},
  "gates": [
    "pnpm run check"
  ],
  "mirror": {
    "enabled": true,
    "sources": [
      "docs"
    ]
  },
  "mergeLog": {
    "file": "docs/MERGES.md",
    "retentionDays": 7
  }
}
