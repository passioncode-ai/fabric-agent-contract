{
  // agent-sync lease records are git-ignored runtime files, not documentation; another session's worktree under
  // .claude/worktrees/ is never this repository's (the gate passes tracked files only; this is the second guard).
  // docs/MERGES.md is written by `agent_sync.py merge` in the tool's own format and rewritten on every merge.
  "ignores": [".agent-sync/**", ".claude/**", "**/node_modules/**", "docs/MERGES.md"],
  "config": {
    "default": true,
    "MD001": false,
    "MD012": false,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    // The organization's licence templates (LICENSE's companions COMMERCIAL-LICENSE.md and CLA.md),
    // the knowledge base's README licensing wording and the AGENTS.md read-first block carry bare
    // addresses (contact@passioncode.ai, wiki.passioncode.ai) and are copied byte for byte.
    "MD034": false,
    "MD032": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  }
}
